# ─────────────────────────────────────────────────────────────────────
# Scar-B-theme — runtime environment variables
# Copy to `.env` (or set in your deployment) and edit as needed.
# All variables are optional; defaults match the dev-server layout.
# ─────────────────────────────────────────────────────────────────────

# Path to the writable site config (read by middleware, runtime cache, /api/config).
# In containers point this at a mounted volume so changes survive restart.
# Default: ./src/config/user.config.json
# SCAR_CONFIG_PATH=/data/scar/user.config.json

# Path to the markdown posts directory (used by /api/posts/* and runtime cache).
# Default: ./src/content/posts
# SCAR_POSTS_DIR=/data/scar/posts

# /api/auth rate limiting — sliding window per client IP.
# Default: 10 failures per 15 minutes (15 * 60 * 1000 ms).
# SCAR_RATE_LIMIT_MAX_FAILS=10
# SCAR_RATE_LIMIT_WINDOW_MS=900000

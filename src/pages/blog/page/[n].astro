---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPostsRuntime } from '../../../lib/posts-runtime';
import { getRuntimeConfig } from '../../../lib/runtime-cache';

const rawPage = Astro.params.n ?? '1';
const page = Number.parseInt(rawPage, 10);

const [allPosts, { config }] = await Promise.all([
  getPostsRuntime(p => !p.frontmatter.draft),
  getRuntimeConfig(),
]);
const pageSize = Math.max(1, config.postsPerPage || 10);
const totalPages = Math.max(1, Math.ceil(allPosts.length / pageSize));

if (!Number.isInteger(page) || page < 1 || page > totalPages) {
  return new Response('Not found', { status: 404 });
}
if (page === 1) {
  return Astro.redirect('/blog');
}

const posts = allPosts.slice((page - 1) * pageSize, page * pageSize);
const prevHref = page === 2 ? '/blog' : `/blog/page/${page - 1}`;
const nextHref = page < totalPages ? `/blog/page/${page + 1}` : '';

function dateOnly(d: string): string {
  return d.slice(0, 10);
}
---

<BaseLayout title={`/blog/page/${page} · hibiki`} description={`Blog page ${page}`}>
  <div class="min-h-screen py-8 md:py-16 px-4">
    <div class="max-w-3xl mx-auto font-mono">

      <header class="mb-10">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between text-sm mb-2" style="color: var(--color-muted);">
          <div>
            <a href="/" class="transition-colors" style="color: var(--color-muted);"
               onmouseover="this.style.color='var(--color-prompt)'"
               onmouseout="this.style.color='var(--color-muted)'">
              <span data-prompt>visitor@hibiki:~$</span>
            </a>
            <span class="mx-2">ls</span>
            <a href="/blog" class="transition-colors" style="color: var(--color-muted);"
               onmouseover="this.style.color='var(--color-prompt)'"
               onmouseout="this.style.color='var(--color-muted)'">~/blog</a>
            <span class="mx-2">--page</span>
            <span style="color: var(--color-cmd);">{page}</span>
          </div>
          <span
            data-theme-toggle
            role="button"
            tabindex="0"
            aria-label="Toggle theme"
            class="cursor-pointer select-none self-start sm:self-auto"
            style="color: var(--color-muted); letter-spacing: 0.05em;"
          >Dark</span>
        </div>
        <h1 class="text-xl font-semibold" style="color: var(--color-text);">
          <span style="color: var(--color-prompt);">~</span>/blog
        </h1>
        <p class="text-sm mt-1" style="color: var(--color-muted);">
          {allPosts.length} post(s) — page {page} / {totalPages}
        </p>
      </header>

      <div class="border-t mb-8" style="border-color: var(--color-border);"></div>

      <ul class="space-y-4 md:space-y-8 list-none p-0">
        {posts.map(post => {
          const dateStr = dateOnly(post.frontmatter.date);
          return (
            <li>
              <div class="text-xs mb-1" style="color: var(--color-muted);">
                <span style="color: var(--color-prompt);">$</span> {dateStr}
              </div>
              <a
                href={`/blog/${post.id}`}
                class="block text-base font-medium transition-colors"
                style="color: var(--color-cmd);"
              >
                {post.frontmatter.title}
              </a>
              <p class="text-sm mt-1 leading-relaxed" style="color: var(--color-muted);">
                {post.frontmatter.description}
              </p>
              {post.frontmatter.tags && post.frontmatter.tags.length > 0 && (
                <div class="mt-2 flex flex-wrap gap-2">
                  {post.frontmatter.tags.map(tag => (
                    <a
                      href={`/tag/${encodeURIComponent(tag)}`}
                      class="text-xs px-2 py-0.5 rounded border transition-colors"
                      style="color: var(--color-accent); background: var(--color-code-bg); border-color: var(--color-border);"
                    >
                      #{tag}
                    </a>
                  ))}
                </div>
              )}
            </li>
          );
        })}
      </ul>

      <nav class="mt-8 flex items-center justify-between text-sm" style="color: var(--color-muted);">
        <a href={prevHref} class="transition-colors"
           style="color: var(--color-cmd);"
           onmouseover="this.style.color='var(--color-link-hover)'"
           onmouseout="this.style.color='var(--color-cmd)'">
          ← prev
        </a>
        <span>page {page} / {totalPages}</span>
        {nextHref ? (
          <a href={nextHref} class="transition-colors"
             style="color: var(--color-cmd);"
             onmouseover="this.style.color='var(--color-link-hover)'"
             onmouseout="this.style.color='var(--color-cmd)'">
            next →
          </a>
        ) : (
          <span style="color: var(--color-muted);">next →</span>
        )}
      </nav>

      <footer class="mt-8 md:mt-16 pt-6 border-t text-sm" style="border-color: var(--color-border); color: var(--color-muted);">
        <a href="/" class="transition-colors"
           style="color: var(--color-muted);"
           onmouseover="this.style.color='var(--color-prompt)'"
           onmouseout="this.style.color='var(--color-muted)'">
          ← back to terminal
        </a>
      </footer>

    </div>
  </div>
</BaseLayout>

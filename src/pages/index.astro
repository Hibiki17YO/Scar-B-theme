---
import BaseLayout from '../layouts/BaseLayout.astro';
import Terminal from '../components/Terminal.astro';
import { getCollection } from 'astro:content';
import { getRuntimeConfig, getPostStats } from '../lib/runtime-cache';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const postsForTerminal = allPosts.map(post => {
  // Use UTC — "YYYY-MM-DD" in frontmatter is parsed as UTC midnight
  const d = post.data.date;
  const pad = (n: number) => String(n).padStart(2, '0');
  const dateStr = `${d.getUTCFullYear()}-${pad(d.getUTCMonth()+1)}-${pad(d.getUTCDate())} ${pad(d.getUTCHours())}:${pad(d.getUTCMinutes())}`;
  return {
    slug:        post.id,
    title:       post.data.title,
    date:        dateStr,
    description: post.data.description,
    tags:        post.data.tags ?? [],
  };
});

// Word count is heavy (reads every post body); cache it by posts-dir fingerprint.
const { totalWords } = await getPostStats(allPosts.map(p => p.id));

let lastUpdateTs = 0;
for (const post of allPosts) {
  const ts = post.data.date.valueOf();
  if (ts > lastUpdateTs) lastUpdateTs = ts;
}
const lastUpdateDate = lastUpdateTs > 0
  ? new Date(lastUpdateTs).toISOString().slice(0, 10)
  : '';

const siteStats = {
  postCount:  allPosts.length,
  wordCount:  totalWords,
  lastUpdate: lastUpdateDate,
};

const { config: runtimeConfig, hasAdminPass, hasBlogPass } = await getRuntimeConfig();
---

<BaseLayout title="visitor@hibiki:~$" description="hibiki's terminal-style personal blog">
  <Terminal posts={postsForTerminal} siteStats={siteStats} config={runtimeConfig} hasAdminPass={hasAdminPass} hasBlogPass={hasBlogPass} />
</BaseLayout>

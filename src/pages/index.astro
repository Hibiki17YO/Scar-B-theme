---
import BaseLayout from '../layouts/BaseLayout.astro';
import Terminal from '../components/Terminal.astro';
import { getRuntimeConfig, getPostStats } from '../lib/runtime-cache';
import { getPostsRuntime } from '../lib/posts-runtime';

const allPosts = await getPostsRuntime(p => !p.frontmatter.draft);

const postsForTerminal = allPosts.map(post => {
  // post.frontmatter.date is a string like "2026-05-16" or "2026-05-16 14:00"
  // Normalize to "YYYY-MM-DD HH:MM" for the terminal display
  const d = post.frontmatter.date;
  const dateStr = d.length >= 16 ? d.slice(0, 16).replace('T', ' ') : `${d} 00:00`;
  return {
    slug:        post.id,
    title:       post.frontmatter.title,
    date:        dateStr,
    description: post.frontmatter.description,
    tags:        post.frontmatter.tags ?? [],
  };
});

// Word count is heavy; cache it by posts-dir fingerprint.
const { totalWords } = await getPostStats(allPosts);

let lastUpdateTs = 0;
for (const post of allPosts) {
  const ts = new Date(post.frontmatter.date.replace(' ', 'T')).valueOf();
  if (!isNaN(ts) && ts > lastUpdateTs) lastUpdateTs = ts;
}
const lastUpdateDate = lastUpdateTs > 0
  ? new Date(lastUpdateTs).toISOString().slice(0, 10)
  : '';

const siteStats = {
  postCount:  allPosts.length,
  wordCount:  totalWords,
  lastUpdate: lastUpdateDate,
};

const { config: runtimeConfig, hasAdminPass, hasBlogPass } = await getRuntimeConfig();
---

<BaseLayout title="visitor@hibiki:~$" description="hibiki's terminal-style personal blog">
  <Terminal posts={postsForTerminal} siteStats={siteStats} config={runtimeConfig} hasAdminPass={hasAdminPass} hasBlogPass={hasBlogPass} />
</BaseLayout>

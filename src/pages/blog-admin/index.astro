---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Blog Admin — Posts" description="Manage blog posts">

  <!-- Auth overlay -->
  <div id="auth-overlay" style="display:none;position:fixed;inset:0;background:var(--color-bg);z-index:100;align-items:center;justify-content:center;">
    <div style="border:1px solid var(--color-border);background:var(--color-terminal);padding:2rem;font-family:var(--font-mono);width:min(440px,90vw);">
      <div style="background:#1a1a1a;border-bottom:1px solid var(--color-border);padding:0.4rem 0.8rem;margin:-2rem -2rem 1.5rem -2rem;font-size:0.75rem;color:var(--color-muted);">blog-admin — authenticate</div>
      <p style="color:var(--color-muted);font-size:0.875rem;margin-bottom:1rem;">
        <span style="color:var(--color-prompt);">visitor@terminal:~$</span>
        <span style="color:var(--color-cmd);"> sudo blog</span>
      </p>
      <div style="display:flex;align-items:center;gap:0.75rem;">
        <span style="color:var(--color-muted);font-size:0.875rem;white-space:nowrap;">password:</span>
        <input id="auth-input" type="password"
          style="flex:1;background:#0d0d0d;border:1px solid var(--color-border);color:var(--color-text);font-family:var(--font-mono);font-size:0.875rem;padding:0.35rem 0.6rem;outline:none;"
          autofocus />
      </div>
      <p id="auth-error" style="color:var(--color-error);font-size:0.8rem;margin-top:0.75rem;display:none;">access denied</p>
    </div>
  </div>

  <!-- Main panel -->
  <div id="blog-panel" style="display:none;">
    <div style="display:flex;justify-content:center;width:100%;">
      <div style="width:100%;max-width:1060px;">

        <!-- Title bar -->
        <div style="background:#1a1a1a;border:1px solid var(--color-border);border-bottom:none;padding:0.5rem 1rem;display:flex;align-items:center;gap:1rem;">
          <span style="color:var(--color-muted);font-size:0.75rem;font-family:var(--font-mono);opacity:0.8;">blog-admin — posts</span>
          <a href="/admin" style="font-size:0.75rem;color:var(--color-muted);text-decoration:none;" onmouseover="this.style.color='var(--color-cmd)'" onmouseout="this.style.color='var(--color-muted)'">config</a>
          <a href="/" style="margin-left:auto;font-size:0.75rem;color:var(--color-muted);text-decoration:none;" onmouseover="this.style.color='var(--color-cmd)'" onmouseout="this.style.color='var(--color-muted)'">← view site</a>
        </div>

        <!-- Panel body -->
        <div style="border:1px solid var(--color-border);background:var(--color-terminal);padding:clamp(1rem,4vw,2rem);font-family:var(--font-mono);">

          <!-- Toolbar -->
          <div style="display:flex;align-items:center;gap:1rem;margin-bottom:1.5rem;">
            <h2 style="color:var(--color-success);font-size:0.75rem;letter-spacing:0.1em;margin:0;font-weight:600;">POSTS</h2>
            <button id="btn-new-post" class="btn-primary" type="button">+ new post</button>
            <span id="list-status" style="color:var(--color-muted);font-size:0.8rem;opacity:0;transition:opacity 0.3s;margin-left:auto;"></span>
          </div>

          <!-- Table header — same grid as data rows -->
          <div class="ba-row ba-header">
            <span>title</span>
            <span>author</span>
            <span>tags</span>
            <span>date</span>
            <span>status</span>
            <span></span>
          </div>

          <!-- Rows container — height driven by per-page count -->
          <div id="posts-list"></div>

          <!-- Pagination footer -->
          <div id="pagination-bar" style="display:none;align-items:center;gap:0.75rem;margin-top:1.25rem;padding-top:1rem;border-top:1px solid var(--color-border);font-size:0.8rem;color:var(--color-muted);">
            <button id="btn-prev" class="ba-btn-page" type="button">‹ prev</button>
            <span id="page-info"></span>
            <button id="btn-next" class="ba-btn-page" type="button">next ›</button>
            <span style="margin-left:auto;display:flex;align-items:center;gap:0.5rem;">
              <span>per page:</span>
              <select id="per-page-select" style="background:#0d0d0d;border:1px solid var(--color-border);color:var(--color-text);font-family:var(--font-mono);font-size:0.8rem;padding:0.2rem 0.4rem;cursor:pointer;">
                <option value="5">5</option>
                <option value="10">10</option>
                <option value="15" selected>15</option>
              </select>
            </span>
          </div>

        </div>
      </div>
    </div>
  </div>

</BaseLayout>

<script is:inline>
  // ── Auth ─────────────────────────────────────────────────────────────────────

  async function sha256hex(s) {
    const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(s));
    return Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2, '0')).join('');
  }

  async function loadConfig() {
    try {
      const res = await fetch('/api/config');
      if (res.ok) return await res.json();
    } catch {}
    return {};
  }

  // ── State ─────────────────────────────────────────────────────────────────────

  let allPosts = [];
  let currentPage = 1;
  let perPage = 15;

  // ── Helpers ───────────────────────────────────────────────────────────────────

  function escHtml(s) {
    return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function showStatus(msg) {
    const el = document.getElementById('list-status');
    el.textContent = msg;
    el.style.opacity = '1';
    setTimeout(() => { el.style.opacity = '0'; }, 2500);
  }

  // ── ROW_HEIGHT: 1 data row = padding-top + content + padding-bottom
  // We set it in CSS as 3rem total (0.9rem top + line + 0.9rem bottom ≈ 3rem)
  // The list container height = perPage * ROW_HEIGHT so it doesn't jump when
  // the last page has fewer rows.
  const ROW_HEIGHT_REM = 3.0;

  function updateListHeight() {
    const container = document.getElementById('posts-list');
    container.style.minHeight = `${perPage * ROW_HEIGHT_REM}rem`;
  }

  // ── Render ────────────────────────────────────────────────────────────────────

  function renderPage() {
    const container = document.getElementById('posts-list');
    container.innerHTML = '';
    updateListHeight();

    if (!Array.isArray(allPosts) || allPosts.length === 0) {
      container.innerHTML = `<div style="color:var(--color-muted);font-size:0.875rem;padding:1.5rem 0;">No posts yet. Click + new post to create one.</div>`;
      document.getElementById('pagination-bar').style.display = 'none';
      return;
    }

    const totalPages = Math.max(1, Math.ceil(allPosts.length / perPage));
    currentPage = Math.min(currentPage, totalPages);
    const start = (currentPage - 1) * perPage;
    const page = allPosts.slice(start, start + perPage);

    for (const post of page) {
      const row = document.createElement('div');
      row.className = 'ba-row ba-data-row';
      row.dataset.id = post.id;
      const tags = Array.isArray(post.tags)
        ? post.tags.map(t => `<span class="ba-tag">#${escHtml(t)}</span>`).join('')
        : '';
      row.innerHTML = `
        <span class="ba-col-overflow"><a href="/blog-admin/${escHtml(post.id)}" class="ba-post-link">${escHtml(post.title || '(untitled)')}</a></span>
        <span class="ba-col-overflow ba-col-muted">${escHtml(post.author || '—')}</span>
        <span class="ba-col-overflow">${tags}</span>
        <span class="ba-col-date">${escHtml(post.date)}</span>
        <span class="${post.draft ? 'ba-status-draft' : 'ba-status-pub'}">${post.draft ? 'draft' : 'pub'}</span>
        <span class="ba-col-actions">
          <button class="btn-delete ba-btn-remove" data-id="${escHtml(post.id)}" type="button">✕</button>
        </span>
      `;
      container.appendChild(row);
    }

    // Bind delete buttons
    container.querySelectorAll('.btn-delete').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const id = btn.dataset.id;
        if (!confirm(`Delete "${id}"?`)) return;
        const res = await fetch(`/api/posts/${encodeURIComponent(id)}`, { method: 'DELETE' });
        if (res.ok) {
          allPosts = allPosts.filter(p => p.id !== id);
          renderPage();
          updatePaginationBar();
          showStatus('✓ deleted');
        } else {
          showStatus('✗ delete failed');
        }
      });
    });

    updatePaginationBar(totalPages);
  }

  function updatePaginationBar(totalPages) {
    const tp = totalPages ?? Math.max(1, Math.ceil(allPosts.length / perPage));
    const bar = document.getElementById('pagination-bar');
    bar.style.display = allPosts.length > 0 ? 'flex' : 'none';
    document.getElementById('page-info').textContent = `page ${currentPage} / ${tp}`;
    document.getElementById('btn-prev').disabled = currentPage <= 1;
    document.getElementById('btn-next').disabled = currentPage >= tp;
  }

  // ── Load & panel ──────────────────────────────────────────────────────────────

  async function loadPosts() {
    try {
      const res = await fetch('/api/posts');
      if (!res.ok) throw new Error(await res.text());
      return await res.json();
    } catch (e) {
      return { error: String(e) };
    }
  }

  async function showPanel() {
    document.getElementById('auth-overlay').style.display = 'none';
    document.getElementById('blog-panel').style.display = 'block';
    updateListHeight();
    const data = await loadPosts();
    if (!Array.isArray(data)) {
      document.getElementById('posts-list').innerHTML =
        `<div style="color:var(--color-error);padding:1rem 0;font-size:0.875rem;">Error: ${escHtml(data.error)}</div>`;
      return;
    }
    allPosts = data;
    renderPage();
  }

  // ── Auth flow ─────────────────────────────────────────────────────────────────

  async function checkAuth() {
    const cfg = await loadConfig();
    const hash = cfg.blogPassHash ?? '';
    if (!hash || sessionStorage.getItem('blog_auth') === '1') { showPanel(); return; }

    document.getElementById('auth-overlay').style.display = 'flex';
    const authInput = document.getElementById('auth-input');
    authInput.focus();
    authInput.addEventListener('keydown', async (e) => {
      if (e.key !== 'Enter') return;
      const val = authInput.value; authInput.value = '';
      if (await sha256hex(val) === hash) {
        sessionStorage.setItem('blog_auth', '1');
        showPanel();
      } else {
        document.getElementById('auth-error').style.display = 'block';
      }
    });
  }

  // ── Wire up ───────────────────────────────────────────────────────────────────

  document.addEventListener('DOMContentLoaded', () => {
    checkAuth();

    document.getElementById('btn-new-post').addEventListener('click', async () => {
      const now = new Date();
      const pad = n => String(n).padStart(2, '0');
      const iso = `${now.getFullYear()}-${pad(now.getMonth()+1)}-${pad(now.getDate())}T${pad(now.getHours())}:${pad(now.getMinutes())}:00`;
      const res = await fetch('/api/posts', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ frontmatter: { title: 'New Post', date: iso, description: '', author: '', tags: [], draft: true }, body: '' }),
      });
      if (res.ok) {
        const { id } = await res.json();
        window.location.href = `/blog-admin/${id}`;
      } else {
        showStatus('✗ failed to create post');
      }
    });

    document.getElementById('btn-prev').addEventListener('click', () => {
      if (currentPage > 1) { currentPage--; renderPage(); }
    });
    document.getElementById('btn-next').addEventListener('click', () => {
      const tp = Math.ceil(allPosts.length / perPage);
      if (currentPage < tp) { currentPage++; renderPage(); }
    });
    document.getElementById('per-page-select').addEventListener('change', (e) => {
      perPage = parseInt(e.target.value, 10);
      currentPage = 1;
      renderPage();
    });
  });
</script>

<style is:global>
  /* Table grid — must be global: JS-created rows don't receive Astro's scoped CID */
  .ba-row {
    display: grid;
    grid-template-columns: minmax(0,1.5fr) minmax(0,1fr) minmax(0,1.6fr) 11rem 3.5rem 2.5rem;
    column-gap: 1rem;
    align-items: center;
    padding: 0.85rem 0.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    font-size: 0.875rem;
    box-sizing: border-box;
    width: 100%;
  }
  .ba-header {
    color: var(--color-muted);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--color-border) !important;
    padding-top: 0;
    padding-bottom: 0.65rem;
  }
  .ba-data-row { transition: background 0.1s; }
  .ba-data-row:hover { background: rgba(255,255,255,0.025); }

  .ba-col-overflow { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
  .ba-col-muted    { color: var(--color-muted); }
  .ba-col-date     { color: var(--color-muted); font-size: 0.8rem; white-space: nowrap; }
  .ba-status-draft { color: var(--color-error);  font-size: 0.78rem; font-weight: 600; }
  .ba-status-pub   { color: var(--color-success); font-size: 0.78rem; font-weight: 600; }
  .ba-col-actions  { display: flex; justify-content: flex-end; align-items: center; }

  .ba-post-link { color: var(--color-cmd); text-decoration: none; transition: color 0.15s; }
  .ba-post-link:hover { color: var(--color-link-hover); text-decoration: underline; }
  .ba-tag { display: inline-block; font-size: 0.72rem; color: var(--color-accent); margin-right: 0.25rem; }

  .ba-btn-page {
    background: transparent; border: 1px solid var(--color-border);
    color: var(--color-muted); font-family: var(--font-mono); font-size: 0.8rem;
    padding: 0.2rem 0.6rem; cursor: pointer; transition: border-color 0.15s, color 0.15s;
  }
  .ba-btn-page:hover:not(:disabled) { border-color: var(--color-muted); color: var(--color-text); }
  .ba-btn-page:disabled { opacity: 0.35; cursor: default; }

  .ba-btn-remove {
    background: transparent; color: var(--color-muted); border: none;
    font-family: var(--font-mono); font-size: 0.875rem; cursor: pointer;
    padding: 0.2rem 0.4rem; transition: color 0.15s;
  }
  .ba-btn-remove:hover { color: var(--color-error); }

  @media (max-width: 640px) {
    .ba-header { display: none; }
    .ba-row {
      display: grid;
      grid-template-columns: 1fr auto;
      column-gap: 0.5rem;
      align-items: center;
      padding: 0.6rem 0.25rem;
      border-bottom: 1px solid rgba(255,255,255,0.07);
    }
    /* title → first column */
    .ba-row > span:nth-child(1) { grid-column: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    /* author → hidden */
    .ba-row > span:nth-child(2) { display: none; }
    /* tags → hidden */
    .ba-row > span:nth-child(3) { display: none; }
    /* date → hidden */
    .ba-row > span:nth-child(4) { display: none; }
    /* status → show inline after title via flex, but simpler: put in col 1 as second line */
    .ba-row > span:nth-child(5) { grid-column: 1; font-size: 0.72rem; margin-top: -0.15rem; }
    /* actions → second column, span 2 rows */
    .ba-col-actions { grid-column: 2; grid-row: 1 / span 2; justify-content: center; }
    .ba-col-overflow { white-space: nowrap; }
  }
</style>

<style>
  /* Scoped styles for static elements that DO get the CID */
  .btn-primary {
    background: var(--color-prompt); color: #0d0d0d; border: none;
    padding: 0.35rem 1rem; font-family: var(--font-mono); font-size: 0.8rem;
    font-weight: 600; cursor: pointer; transition: opacity 0.15s;
  }
  .btn-primary:hover { opacity: 0.85; }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Blog Admin — Edit Post" description="Edit blog post">

  <!-- Auth overlay -->
  <div id="auth-overlay" style="display:none;position:fixed;inset:0;background:var(--color-bg);z-index:100;align-items:center;justify-content:center;">
    <div style="border:1px solid var(--color-border);background:var(--color-terminal);padding:2rem;font-family:var(--font-mono);width:min(440px,90vw);">
      <div style="background:#1a1a1a;border-bottom:1px solid var(--color-border);padding:0.4rem 0.8rem;margin:-2rem -2rem 1.5rem -2rem;font-size:0.75rem;color:var(--color-muted);">blog-admin — authenticate</div>
      <p style="color:var(--color-muted);font-size:0.875rem;margin-bottom:1rem;">
        <span style="color:var(--color-prompt);">visitor@terminal:~$</span>
        <span style="color:var(--color-cmd);"> sudo blog</span>
      </p>
      <div style="display:flex;align-items:center;gap:0.75rem;">
        <span style="color:var(--color-muted);font-size:0.875rem;white-space:nowrap;">password:</span>
        <input id="auth-input" type="password"
          style="flex:1;background:#0d0d0d;border:1px solid var(--color-border);color:var(--color-text);font-family:var(--font-mono);font-size:0.875rem;padding:0.35rem 0.6rem;outline:none;"
          autofocus />
      </div>
      <p id="auth-error" style="color:var(--color-error);font-size:0.8rem;margin-top:0.75rem;display:none;">access denied</p>
    </div>
  </div>

  <!-- Editor panel -->
  <div id="editor-panel" style="display:none;">
    <div style="display:flex;justify-content:center;width:100%;">
      <div style="width:100%;max-width:1000px;">

        <!-- Title bar -->
        <div style="background:#1a1a1a;border:1px solid var(--color-border);border-bottom:none;padding:0.5rem 1rem;display:flex;align-items:center;gap:1rem;">
          <span id="title-bar-id" style="color:var(--color-muted);font-size:0.75rem;font-family:var(--font-mono);opacity:0.8;">blog-admin — editor</span>
          <a href="/blog-admin" style="font-size:0.75rem;color:var(--color-muted);text-decoration:none;" onmouseover="this.style.color='var(--color-cmd)'" onmouseout="this.style.color='var(--color-muted)'">← all posts</a>
          <a href="/" style="margin-left:auto;font-size:0.75rem;color:var(--color-muted);text-decoration:none;" onmouseover="this.style.color='var(--color-cmd)'" onmouseout="this.style.color='var(--color-muted)'">view site</a>
        </div>

        <!-- Panel body -->
        <div style="border:1px solid var(--color-border);background:var(--color-terminal);padding:2rem;font-family:var(--font-mono);">

          <h2 style="color:var(--color-success);font-size:0.75rem;letter-spacing:0.1em;margin:0 0 1.5rem 0;font-weight:600;">FRONTMATTER</h2>

          <!-- title -->
          <div class="field-row">
            <label class="field-label" for="f-title">title</label>
            <input id="f-title" type="text" class="field-input" placeholder="Post title" />
          </div>

          <!-- date -->
          <div class="field-row" style="margin-top:0.75rem;">
            <label class="field-label" for="f-date">date &amp; time</label>
            <input id="f-date" type="datetime-local" class="field-input" />
          </div>

          <!-- author -->
          <div class="field-row" style="margin-top:0.75rem;">
            <label class="field-label" for="f-author">author</label>
            <input id="f-author" type="text" class="field-input" placeholder="author name" />
          </div>

          <!-- description -->
          <div class="field-col" style="margin-top:0.75rem;">
            <label class="field-label" for="f-description">description</label>
            <textarea id="f-description" rows="2" class="field-textarea" placeholder="Short post description"></textarea>
          </div>

          <!-- tags -->
          <div class="field-row" style="margin-top:0.75rem;">
            <label class="field-label" for="f-tags">tags <span class="hint">(comma-separated)</span></label>
            <input id="f-tags" type="text" class="field-input" placeholder="astro, blog, terminal" />
          </div>

          <!-- draft -->
          <div class="field-row" style="margin-top:0.75rem;">
            <label class="field-label" for="f-draft">draft</label>
            <label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;font-size:0.875rem;color:var(--color-muted);">
              <input id="f-draft" type="checkbox" style="accent-color:var(--color-prompt);width:1rem;height:1rem;cursor:pointer;" />
              <span>mark as draft (hidden from public listing)</span>
            </label>
          </div>

          <!-- readingTime -->
          <div class="field-row" style="margin-top:0.75rem;">
            <label class="field-label" for="f-reading-time">reading time <span class="hint">(minutes, optional)</span></label>
            <input id="f-reading-time" type="number" min="1" class="field-input" placeholder="5" style="max-width:8rem;" />
          </div>

          <div style="border-top:1px solid var(--color-border);margin:1.5rem 0;"></div>

          <h2 style="color:var(--color-success);font-size:0.75rem;letter-spacing:0.1em;margin:0 0 1rem 0;font-weight:600;">BODY <span style="color:var(--color-muted);font-weight:400;">(markdown)</span></h2>

          <textarea id="f-body" rows="24" class="field-textarea body-textarea" placeholder="# Post title&#10;&#10;Write your post here in Markdown..."></textarea>

          <div style="border-top:1px solid var(--color-border);margin:1.5rem 0;"></div>

          <!-- Actions -->
          <div style="display:flex;gap:1rem;align-items:center;flex-wrap:wrap;">
            <button id="btn-save" class="btn-primary" type="button">save</button>
            <button id="btn-delete" class="btn-danger" type="button">delete post</button>
            <span id="save-status" style="color:var(--color-success);font-size:0.875rem;opacity:0;transition:opacity 0.3s;"></span>
            <a id="view-post-link" href="#" style="margin-left:auto;font-size:0.875rem;color:var(--color-muted);text-decoration:none;font-family:var(--font-mono);" onmouseover="this.style.color='var(--color-cmd)'" onmouseout="this.style.color='var(--color-muted)'">view post →</a>
          </div>

        </div>
      </div>
    </div>
  </div>

</BaseLayout>

<script is:inline>
  const TOKEN_KEY = 'blog_token';
  function getToken() { return sessionStorage.getItem(TOKEN_KEY) || ''; }

  async function sha256hex(s) {
    const data = new TextEncoder().encode(s);
    if (typeof crypto !== 'undefined' && crypto.subtle) {
      const buf = await crypto.subtle.digest('SHA-256', data);
      return Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2, '0')).join('');
    }
    return sha256js(data);
  }

  function sha256js(data) {
    function rightRotate(v, a) { return (v >>> a) | (v << (32 - a)); }
    const K = [
      0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
      0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
      0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
      0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
      0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
      0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
      0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
      0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2,
    ];
    let h = [0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19];
    const len = data.length;
    const bitLen = len * 8;
    const padded = new Uint8Array(((len + 9 + 63) >> 6) << 6);
    padded.set(data);
    padded[len] = 0x80;
    new DataView(padded.buffer).setUint32(padded.length - 4, bitLen >>> 0, false);
    for (let i = 0; i < padded.length; i += 64) {
      const w = new Array(64);
      const dv = new DataView(padded.buffer, i, 64);
      for (let j = 0; j < 16; j++) w[j] = dv.getUint32(j * 4, false);
      for (let j = 16; j < 64; j++) {
        const s0 = rightRotate(w[j-15],7) ^ rightRotate(w[j-15],18) ^ (w[j-15] >>> 3);
        const s1 = rightRotate(w[j-2],17) ^ rightRotate(w[j-2],19)  ^ (w[j-2] >>> 10);
        w[j] = (w[j-16] + s0 + w[j-7] + s1) >>> 0;
      }
      let [a,b,c,d,e,f,g,hh] = h;
      for (let j = 0; j < 64; j++) {
        const S1 = rightRotate(e,6) ^ rightRotate(e,11) ^ rightRotate(e,25);
        const ch = (e & f) ^ (~e & g);
        const temp1 = (hh + S1 + ch + K[j] + w[j]) >>> 0;
        const S0 = rightRotate(a,2) ^ rightRotate(a,13) ^ rightRotate(a,22);
        const maj = (a & b) ^ (a & c) ^ (b & c);
        const temp2 = (S0 + maj) >>> 0;
        hh=g; g=f; f=e; e=(d+temp1)>>>0; d=c; c=b; b=a; a=(temp1+temp2)>>>0;
      }
      h = h.map((v,i) => ([a,b,c,d,e,f,g,hh][i] + v) >>> 0);
    }
    return h.map(v => v.toString(16).padStart(8,'0')).join('');
  }

  async function verifyToken(hash) {
    try {
      const res = await fetch('/api/auth', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ kind: 'blog', hash }),
      });
      return res.ok;
    } catch { return false; }
  }

  async function loadConfig() {
    try {
      const res = await fetch('/api/config');
      if (res.ok) return await res.json();
    } catch {}
    return {};
  }

  function getPostId() {
    const parts = window.location.pathname.split('/');
    return parts[parts.length - 1] || parts[parts.length - 2];
  }

  function showStatus(msg, isError = false) {
    const el = document.getElementById('save-status');
    el.textContent = msg;
    el.style.color = isError ? 'var(--color-error)' : 'var(--color-success)';
    el.style.opacity = '1';
    setTimeout(() => { el.style.opacity = '0'; }, 3000);
  }

  async function loadPost(id) {
    const res = await fetch(`/api/posts/${encodeURIComponent(id)}`);
    if (!res.ok) return null;
    return await res.json();
  }

  function fillForm(post) {
    const fm = post.frontmatter;

    // Convert stored date (may be "YYYY-MM-DD" or ISO string) to "YYYY-MM-DDTHH:MM"
    let dtVal = '';
    if (fm.date) {
      const d = new Date(fm.date.includes('T') ? fm.date : fm.date + 'T00:00');
      const pad = n => String(n).padStart(2, '0');
      dtVal = `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
    }
    document.getElementById('f-title').value = fm.title ?? '';
    document.getElementById('f-date').value = dtVal;
    document.getElementById('f-author').value = fm.author ?? '';
    document.getElementById('f-description').value = fm.description ?? '';
    document.getElementById('f-tags').value = Array.isArray(fm.tags) ? fm.tags.join(', ') : '';
    document.getElementById('f-draft').checked = Boolean(fm.draft);
    document.getElementById('f-reading-time').value = fm.readingTime != null ? fm.readingTime : '';
    document.getElementById('f-body').value = post.body ?? '';
  }

  function collectForm() {
    const tagsRaw = document.getElementById('f-tags').value;
    const tags = tagsRaw.split(',').map(t => t.trim()).filter(Boolean);
    const rt = document.getElementById('f-reading-time').value;
    // datetime-local gives "YYYY-MM-DDTHH:MM", store as-is (Astro coerces via z.coerce.date)
    const rawDate = document.getElementById('f-date').value; // "YYYY-MM-DDTHH:MM"
    const dateStr = rawDate ? rawDate.replace('T', ' ') : new Date().toISOString().slice(0, 16).replace('T', ' ');
    return {
      frontmatter: {
        title: document.getElementById('f-title').value.trim(),
        date: dateStr,
        author: document.getElementById('f-author').value.trim(),
        description: document.getElementById('f-description').value.trim(),
        tags,
        draft: document.getElementById('f-draft').checked,
        readingTime: rt ? parseInt(rt, 10) : undefined,
      },
      body: document.getElementById('f-body').value,
    };
  }

  async function checkAuth() {
    const cfg = await loadConfig();
    const passSet = cfg.hasBlogPass === true;
    if (!passSet) { showPanel(); return; }

    const existing = getToken();
    if (existing && await verifyToken(existing)) { showPanel(); return; }
    if (existing) sessionStorage.removeItem(TOKEN_KEY);

    const overlay = document.getElementById('auth-overlay');
    overlay.style.display = 'flex';
    const authInput = document.getElementById('auth-input');
    authInput.focus();

    authInput.addEventListener('keydown', async (e) => {
      if (e.key !== 'Enter') return;
      const val = authInput.value;
      authInput.value = '';
      const inputHash = await sha256hex(val);
      if (await verifyToken(inputHash)) {
        sessionStorage.setItem(TOKEN_KEY, inputHash);
        showPanel();
      } else {
        document.getElementById('auth-error').style.display = 'block';
      }
    });
  }

  async function showPanel() {
    document.getElementById('auth-overlay').style.display = 'none';
    document.getElementById('editor-panel').style.display = 'block';

    const id = getPostId();
    document.getElementById('title-bar-id').textContent = `blog-admin — ${id}`;
    document.getElementById('view-post-link').href = `/blog/${id}`;

    const post = await loadPost(id);
    if (post) {
      fillForm(post);
    } else {
      showStatus('✗ post not found', true);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    checkAuth();

    document.getElementById('btn-save').addEventListener('click', async () => {
      const id = getPostId();
      const data = collectForm();
      const res = await fetch(`/api/posts/${encodeURIComponent(id)}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json', 'X-Blog-Token': getToken() },
        body: JSON.stringify(data),
      });
      if (res.ok) {
        showStatus('✓ saved');
      } else if (res.status === 401) {
        sessionStorage.removeItem(TOKEN_KEY);
        showStatus('✗ unauthorized — refresh to log in', true);
      } else {
        showStatus('✗ save failed', true);
      }
    });

    document.getElementById('btn-delete').addEventListener('click', async () => {
      const id = getPostId();
      if (!confirm(`Delete "${id}"? This cannot be undone.`)) return;
      const res = await fetch(`/api/posts/${encodeURIComponent(id)}`, {
        method: 'DELETE',
        headers: { 'X-Blog-Token': getToken() },
      });
      if (res.ok) {
        window.location.href = '/blog-admin';
      } else if (res.status === 401) {
        sessionStorage.removeItem(TOKEN_KEY);
        showStatus('✗ unauthorized — refresh to log in', true);
      } else {
        showStatus('✗ delete failed', true);
      }
    });
  });
</script>

<style>
  .field-row { display: flex; align-items: center; gap: 1rem; }
  .field-col { display: flex; flex-direction: column; gap: 0.4rem; }
  .field-label { color: var(--color-muted); font-size: 0.8rem; min-width: 10rem; flex-shrink: 0; }
  .hint { font-size: 0.7rem; opacity: 0.6; }
  .field-input {
    background: #0d0d0d; border: 1px solid var(--color-border);
    color: var(--color-text); font-family: var(--font-mono); font-size: 0.875rem;
    padding: 0.35rem 0.6rem; outline: none; flex: 1; transition: border-color 0.15s;
  }
  .field-input:focus { border-color: var(--color-prompt); }
  .field-textarea {
    background: #0d0d0d; border: 1px solid var(--color-border);
    color: var(--color-text); font-family: var(--font-mono); font-size: 0.875rem;
    padding: 0.5rem 0.6rem; outline: none; resize: vertical; width: 100%;
    line-height: 1.5; transition: border-color 0.15s;
  }
  .field-textarea:focus { border-color: var(--color-prompt); }
  .body-textarea { font-size: 0.9rem; line-height: 1.7; min-height: 480px; }

  .btn-primary {
    background: var(--color-prompt); color: #0d0d0d; border: none;
    padding: 0.45rem 1.2rem; font-family: var(--font-mono); font-size: 0.875rem;
    font-weight: 600; cursor: pointer; transition: opacity 0.15s;
  }
  .btn-primary:hover { opacity: 0.85; }
  .btn-danger {
    background: transparent; color: var(--color-error); border: 1px solid var(--color-error);
    padding: 0.45rem 1.2rem; font-family: var(--font-mono); font-size: 0.875rem;
    cursor: pointer; transition: background 0.15s, color 0.15s;
    opacity: 0.7;
  }
  .btn-danger:hover { background: var(--color-error); color: #0d0d0d; opacity: 1; }
</style>

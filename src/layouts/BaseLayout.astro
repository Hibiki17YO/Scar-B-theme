---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'hibiki · blog',
  description = 'A terminal-style personal blog.',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" id="site-favicon" />
    <link rel="alternate" type="application/rss+xml" title="RSS feed" href="/rss.xml" />
    <title>{title}</title>
    <script is:inline>
      (function() {
        try {
          var theme = localStorage.getItem('theme');
          if (theme === 'light' || theme === 'amaris') document.documentElement.dataset.theme = theme;
        } catch {}
      })();
    </script>
    <script is:inline>
      (function() {
        var labels = { dark: 'Dark', light: 'Eliana', amaris: 'Amaris' };
        var cycle = ['dark', 'light', 'amaris'];

        function currentTheme() {
          return document.documentElement.dataset.theme || 'dark';
        }

        function applyLabel(el, theme) {
          el.textContent = labels[theme] || theme;
        }

        function syncToggles(theme) {
          document.querySelectorAll('[data-theme-toggle]').forEach(function(el) {
            applyLabel(el, theme);
          });
        }

        function setTheme(theme) {
          if (theme === 'dark') delete document.documentElement.dataset.theme;
          else document.documentElement.dataset.theme = theme;
          syncToggles(theme);
          try { localStorage.setItem('theme', theme); } catch {}
        }

        function handleToggle(e) {
          e.preventDefault();
          e.stopPropagation();
          var idx = cycle.indexOf(currentTheme());
          setTheme(cycle[(idx + 1) % cycle.length]);
        }

        function init() {
          var toggles = document.querySelectorAll('[data-theme-toggle]');
          if (!toggles.length) return;
          syncToggles(currentTheme());
          toggles.forEach(function(el) {
            el.addEventListener('click', handleToggle);
            el.addEventListener('keydown', function(e) {
              if (e.key === 'Enter' || e.key === ' ') handleToggle(e);
            });
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init, { once: true });
        } else {
          init();
        }
      })();
    </script>
    <script is:inline>
      (function() {
        fetch('/api/config').then(function(r){ return r.json(); }).then(function(cfg) {
          if (cfg.siteTitle) document.title = cfg.siteTitle;
          if (cfg.siteIconUrl) {
            var el = document.getElementById('site-favicon');
            if (el) { el.href = cfg.siteIconUrl; el.type = cfg.siteIconUrl.endsWith('.ico') ? 'image/x-icon' : 'image/svg+xml'; }
          }
          var prompt = (cfg.username || 'visitor') + '@' + (cfg.hostname || 'hibiki') + ':~$';
          document.querySelectorAll('[data-prompt]').forEach(function(el) { el.textContent = prompt; });
        }).catch(function(){});
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

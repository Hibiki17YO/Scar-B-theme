{
  "name": "scar-b-theme",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src test",
    "format": "prettier --write \"src/**/*.{ts,astro,css}\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,astro,css}\" \"test/**/*.ts\""
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.5",
    "@astrojs/node": "^10.1.1",
    "@astrojs/rss": "^4.0.18",
    "astro": "^6.3.2",
    "marked": "^18.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitest/coverage-v8": "^4.1.6",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^10.4.0",
    "eslint-plugin-astro": "^1.7.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.3.0",
    "vitest": "^4.1.6",
    "zod": "^4.4.3"
  }
}
